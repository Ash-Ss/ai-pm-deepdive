# Copy to .env.local and fill in. Server-side only — never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional; defaults to a Flash model if empty.
GEMINI_MODEL=
# Optional: MINIMAL | LOW | MEDIUM | HIGH thinking for Gemini 3 models (LOW is much faster).
GEMINI_THINKING_LEVEL=
# Turn the Gemini layer on (falls back to heuristic + templates when off or failing).
USE_AI=
# Optional dev cache for LLM responses (saves free-tier quota).
LLM_CACHE=
# Demo mode: when a Gemini call fails (rate limit, no key, offline), serve recorded answers
# for the demo scenarios from data/demo-cache. Works even without GEMINI_API_KEY.
DEMO_CACHE=
# Record successful Gemini answers into data/demo-cache (run: USE_AI=true DEMO_RECORD=true npm run scenarios).
DEMO_RECORD=
